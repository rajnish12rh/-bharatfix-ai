PORT=5000
MONGODB_URI=
# Optional: enables real AI image analysis. Without it, /api/analyze returns a labeled demo result.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: when set, updating report status on the dashboard requires this key.
ADMIN_KEY=
# Optional: comma-separated frontend URLs allowed by CORS (e.g. https://bharatfix.vercel.app). Empty allows all.
CLIENT_URL=
